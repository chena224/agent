# ============ 部署档 ============
# standalone=单机(SQLite+Milvus Lite+线程任务,默认,开箱即用)
# cluster=多实例可扩容(IvorySQL+独立Milvus+Redis+Celery+TEI,部署时固定,运行中不可切换)
DEPLOY_PROFILE=standalone

# ============ cluster 档:数据库 ============
# 业务库(IvorySQL,兼容 PG 协议)。DSN 格式(含密码):
#   postgresql+psycopg://rag:rag_password@ivorysql:5432/rag_db
DB_URI=postgresql+psycopg://rag:rag_password@ivorysql:5432/rag_db
# LangGraph 会话检查点库(建议与业务库分库):
#   postgresql://rag:rag_password@ivorysql:5432/rag_checkpoint
CHECKPOINT_DB_URI=postgresql://rag:rag_password@ivorysql:5432/rag_checkpoint
# 多实例同时启动时 checkpointer.setup() 的幂等 DDL 会争抢锁;
# 生产在部署阶段一次性建表后置 1(单实例/standalone 保持 0)
SKIP_CHECKPOINTER_SETUP=0

# ============ cluster 档:缓存/任务 ============
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============ cluster 档:向量与嵌入 ============
MILVUS_URI=http://milvus:19530
# local=web 进程内加载 BGE 模型(standalone 默认);tei=独立 TEI 服务(cluster 推荐)
EMBEDDING_MODE=local
TEI_URL=http://tei:8080

# ============ LLM ============
# 主 Key(也可在「设置」页配置;env 优先级更高,便于容器注入)
DEEPSEEK_API_KEY=
# 备用 Key:主 Key 调用失败时自动切换(快速失败+熔断),可选
DEEPSEEK_BACKUP_API_KEY=
# 拒答是否经 LLM 润色(1=润色,0=模板直出)
REFUSAL_LLM=0

# ============ 安全 ============
# CORS 白名单(逗号分隔);standalone 演示为空即放开 *
CORS_ORIGINS=http://localhost,https://rag.example.com
# 演示账号/演示知识库种子:生产必须置 0
SEED_DEMO_DATA=1
# admin 初始密码(仅首次建库时生效):生产必须注入强口令并第一时间改密
ADMIN_PASSWORD=admin123
# 聊天限流(次/分钟/用户)
RATE_LIMIT_CHAT_PER_MIN=60
# 上传大小上限(MB),需与 nginx client_max_body_size 一致
UPLOAD_MAX_MB=50
