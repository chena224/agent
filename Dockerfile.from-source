# ---------- 前端构建(源码全量重建,可选;默认 Dockerfile 已用预编译 dist) ----------
# 用法: docker build -f Dockerfile.from-source -t rag-app .
# 注意:刻意使用 22 而非 20——旧缓存的 node:20-slim 镜像(内置 npm 9.x)读不懂
# npm 11 生成的 lockfileVersion:3,会"装完"却静默缺包;换标签强制重新拉取
FROM node:22-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
# 弱网加固:拉大重试与超时,规避 npm "Exit handler never called" 抖动
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000
# 优先 npmmirror(国内网络),失败回退官方源;typescript/vite 均在 devDependencies,
# npm ci 会装全——不需要也不允许再加 npm install -D typescript 之类的补丁层
RUN npm ci --no-audit --no-fund --registry=https://registry.npmmirror.com \
    || npm ci --no-audit --no-fund
# 自证: 打印进容器的文件指纹,不一致说明本地文件是旧版,请重新下载
RUN echo "node=$(node -v) npm=$(npm -v)" && sha256sum package.json package-lock.json \
    && npm ls typescript || true
COPY index.html vite.config.ts tsconfig.json \
     tailwind.config.js postcss.config.js components.json ./
COPY src ./src
RUN npm run build

# ---------- 运行时 ----------
# 换 3.12 强制拉新镜像;且 3.12 是依赖联调的实测环境
FROM python:3.12-slim

# opencv 运行时依赖(扫描件 OCR 用)
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY server/requirements.txt server/requirements.txt
RUN pip install --retries 5 --timeout 100 \
    -i https://pypi.tuna.tsinghua.edu.cn/simple -r server/requirements.txt \
    || pip install --retries 5 --timeout 100 -r server/requirements.txt

COPY server ./server
COPY --from=frontend /build/dist ./dist

ENV HF_ENDPOINT=https://hf-mirror.com HF_HUB_DISABLE_XET=1
RUN python3 -c "import sys; sys.path.insert(0,'server'); \
    from app.embeddings import Embedder; Embedder.get().warmup(); \
    print('embedding model cached')" \
    || echo "embedding model download deferred to first use"

ENV DATA_DIR=/app/server/data FRONTEND_DIST=/app/dist
EXPOSE 3000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--app-dir", "server", \
     "--host", "0.0.0.0", "--port", "3000"]
